# Use the SAME MongoDB cluster AND database as the Fatimaz Next.js application.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/
# Portable DB name only: letters, numbers, _ or -. Do not paste shell commands here.
MONGODB_DB=Fatimaz

WHATSAPP_WORKER_ID=fatimaz-whatsapp-production
WHATSAPP_LOG_LEVEL=warn

# Reliability / throughput defaults. One WhatsApp session should have ONE active worker lease.
WHATSAPP_QUEUE_CONCURRENCY=2
WHATSAPP_SEND_INTERVAL_MS=400
WHATSAPP_WORKER_LEASE_MS=30000
WHATSAPP_JOB_LOCK_MS=120000
WHATSAPP_SOCKET_READY_TIMEOUT_MS=15000
